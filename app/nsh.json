{
  "name": "DexDrop",
  "id": "dev.dexdrop.app",
  "version": "0.1.0",
  "build": 1,
  "icon": {
    "ios": "icon-ios.png",
    "macos": "icon-macos.png",
    "android": {
      "foreground": "icon-android-foreground.png",
      "background": "#ffffff",
      "monochrome": "icon-android-monochrome.png"
    },
    "windows": "icon.png",
    "linux": "icon.png",
    "web": "icon.png"
  },
  "rust": ".",
  "root": "App",
  "theme": "theme.json",
  "appearance": "system",
  "application": {
    "quitMode": "lastWindowClosed"
  },
  "fileTypes": [
    {
      "name": "File",
      "mimeTypes": [
        "*/*"
      ],
      "contentTypes": [
        "public.data"
      ]
    }
  ],
  "ios": {
    "launchScreen": {
      "background": {
        "light": "#fbfaf8",
        "dark": "#070707"
      },
      "image": "launch.png"
    },
    "infoPlist": {
      "NSLocalNetworkUsageDescription": "DexDrop finds your other devices on this network and sends files to them directly.",
      "NSBonjourServices": [
        "_dexdrop._tcp"
      ],
      "UIFileSharingEnabled": true,
      "LSSupportsOpeningDocumentsInPlace": true
    }
  },
  "macos": {
    "infoPlist": {
      "NSLocalNetworkUsageDescription": "DexDrop finds your other devices on this network and sends files to them directly.",
      "NSBonjourServices": [
        "_dexdrop._tcp"
      ],
      "LSApplicationCategoryType": "public.app-category.utilities"
    }
  },
  "android": {
    "targetSdk": 35,
    "permissions": [
      "REQUEST_INSTALL_PACKAGES"
    ],
    "launchScreen": {
      "background": {
        "light": "#fbfaf8",
        "dark": "#070707"
      },
      "image": "launch.png"
    }
  }
}
